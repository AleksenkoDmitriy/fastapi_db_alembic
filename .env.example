ORIGINS=*
PORT=8000
ROOT_PATH=/api/v1

ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_ALGORITHM=HS256

POSTGRES_SCHEMA=blog
POSTGRES_HOST=db
POSTGRES_DB=blog
POSTGRES_PORT=5432
POSTGRES_USER=blog
POSTGRES_PASSWORD=blogpass
POSTGRES_RECONNECT_INTERVAL_SEC=1

APP_NAME=FastAPI Blog API
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO
LOG_FILE=/fastapi_app/logs/app.log